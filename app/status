#!/usr/bin/env bash
set -e

printf "Content-type: application/json\n\n"

mode=$(cat /app/settings/mode 2>/dev/null || echo "unknown")
peers=""

if [ -f /app/tmp/peers.txt ]; then
  peers=$(paste -sd, /app/tmp/peers.txt 2>/dev/null || echo "")
fi

doom_running="false"
if pgrep -x chocolate-doom > /dev/null 2>&1; then
  doom_running="true"
fi

cat <<EOF
{"mode":"${mode}","doom_running":${doom_running},"peers":"${peers}"}
EOF
