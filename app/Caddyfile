{
	order cgi before respond
}

:{$PORT} {
	root * /app/www
	file_server

	cgi /key/down/* /app/keys {
		script_name /key/down
	}
	cgi /key/up/* /app/keys {
		script_name /key/up
	}
	cgi /reset /app/reset {
		script_name /reset
	}
	cgi /config/* /app/config {
		script_name /config
	}
	cgi /status /app/status {
		script_name /status
	}
}
